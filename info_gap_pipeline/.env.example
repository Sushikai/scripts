# 环境变量模板（复制为 .env_minimax 使用）

# MiniMax API
ANTHROPIC_BASE_URL=https://api.minimax.com/anthropic
MINIMAX_API_KEY=your_api_key_here

# B站Cookies（文件路径，JSON格式）
BILIBILI_COOKIES=/Users/kaikai/.bilibili_cookies.json

# 可选：TTS服务（Edge-TTS需要网络）
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# EDGE_TTS_RATE=+0%
# EDGE_TTS_PITCH=+0Hz