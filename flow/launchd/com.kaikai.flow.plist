<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kaikai.flow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kaikai/scripts/flow/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kaikai/scripts/flow</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/kaikai/scripts/flow/logs/flow.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kaikai/scripts/flow/logs/flow.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FLOW_PORT</key>
        <string>8810</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>