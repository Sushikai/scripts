# flow 平台环境变量模板

# 服务端口(默认 8810)
FLOW_PORT=8810

# 数据路径
FLOW_DB=./flow.db
FLOW_CACHE_DB=./cache.db
FLOW_ACCESS_LOG=./access.log

# 限频(默认 60/min,测试时可调到 100000)
FLOW_RATE_LIMIT_DEFAULT=60
FLOW_RATE_LIMIT_AI=20
FLOW_RATE_LIMIT_JOB=10

# Job 并发
FLOW_JOB_MAX=2

# 鉴权(可选)
FLOW_LOCAL_TOKEN=flow-local-dev-token

# AI API key(用 MiniMax 时设 MINIMAX_API_KEY)
# MINIMAX_API_KEY=your-key

# Redis(可选,留空走 SQLite L2)
# FLOW_USE_REDIS=1
# FLOW_REDIS_URL=redis://localhost:6379/0