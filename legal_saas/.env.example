# .env.example — copy to .env and fill in real values.  NEVER commit .env.
#
# 加载路径: backend/app/config.py 读 env 或显式 .env
# 验证: 启动前 echo $MINIMAX_API_KEY | head -c 8  应看到 "sk-cp-" 或 "sk-api-"

# ───── MiniMax API (核心 LLM) ─────
MINIMAX_API_KEY=sk-PLACEHOLDER-replace-me
MINIMAX_BASE_URL=https://api.MiniMax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ───── 法条 API (可选,接第三方如 pkulaw / 北大法宝) ─────
STATUTE_API_KEY=
STATUTE_API_BASE=https://api.example.com

# ───── Embedding ─────
EMBEDDING_PROVIDER=minimax  # minimax | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ───── Server ─────
LEGAL_PORT=7800
LEGAL_HOST=0.0.0.0
LEGAL_DEBUG=false

# ───── 本地加密 Key (Fernet,首次启动自动生成) ─────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ───── 数据路径 ─────
DATA_DIR=./data
DB_PATH=./data/db.sqlite
VECTOR_STORE_PATH=./data/vector_store
EXPORT_DIR=./data/exports

# ───── 检索参数 ─────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=20
HYBRID_VECTOR_WEIGHT=0.7

# ───── 任务队列 ─────
TASK_WORKERS=2
TASK_MAX_CONCURRENT=4