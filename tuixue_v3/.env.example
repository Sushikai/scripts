# .env.example — copy to .env and fill in real values.  NEVER commit .env.
#
# 加载路径: web/start_remote.sh 第 26 行 source $HOME/.hermes/env.sh
# 若你不想走 ~/.hermes/env.sh, 可改用 direnv / python-dotenv / set -a; source .env; set +a
#
# 验证: 启动 server 前 echo $MINIMAX_API_KEY | head -c 8  应看到 "sk-cp-" 或 "sk-api-"

# ───── MiniMax API (AI 复盘 / AI 选股 / AI 对话) ─────
# 控制台: https://platform.MiniMax.io → API Keys
MINIMAX_API_KEY=sk-PLACEHOLDER-replace-me
MINIMAX_BASE_URL=https://api.MiniMax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ───── HTTP 代理 (沙箱环境可能需要) ─────
# 不需要代理就保持空值
HTTP_PROXY=
HTTPS_PROXY=
PROXY_ALL=false

# ───── Server 端口与跨域 ─────
TUIXUE_PORT=7799

# ───── 行情预热 (TUIXUE_PREHEAT_*) ─────
# 独立预热服务地址,用于降低主服务 TTFB
TUIXUE_PREHEAT_HOST=127.0.0.1
TUIXUE_PREHEAT_PORT=7798

# ───── Redis (可选, 不配走进程内 dict) ─────
TUIXUE_USE_REDIS=false
TUIXUE_REDIS_URL=redis://127.0.0.1:6379/0

# ───── iTick 免费 WS+REST 数据源 (2026-07-16 新增) ─────
# 注册地址: https://itick.org (邮箱即可,免费层无需付费)
# 免费配额: REST 60次/分钟, WS 同时订阅 50 标的 tick 推送
# 不配 token 时模块禁用, lib_common._REALTIME_SOURCES 自动跳过 itick_rest
# 推荐设置: 项目目前所有 quote 都已有 fallback, iTick 作为最后兜底 (Tick 毫秒级)
TUIXUE_ITICK_TOKEN=
