# Python bytecode
__pycache__/
*.pyc
*.pyo

# Generated SQLite caches
*.db
*.db-shm
*.db-wal

# Runtime caches and logs
cache/
logs/
reports/
data/news_cache.json
data/sector_cache.json

# Debug screenshots / playwright traces
*.png
.playwright-mcp/
dash-*.png
homepage-*.png
watchlist*.png
stock-*.png
theme-*.png
screen-page-*.png
review-page.png

# Secrets — never commit real keys/tokens
.env
.env.*
!.env.example
.envrc
*.pem
*.key
cookies/
.bilibili_cookies.json

# Runtime caches (重建成本高,不入仓;本地调试需要)
data/backups/
data/daily_cache/
data/intraday_cache/
data/screener_snapshots/

# Tunnel runtime state (跨进程 IPC)
tunnel_*.txt
stock_page.txt

# Random binary (wechat 截图等不入仓)
*.jpg
!web/static/**/*.jpg
!web/static/**/*.png
